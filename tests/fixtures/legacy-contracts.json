  "critical_scenarios": [
    {
      "id": "LEGACY-MERGE-BEHIND",
      "source_contracts": [
        "MERGE",
        "MERGE-BEHIND"
      ],
      "action": "Run preserved --checks on a fixture branch behind dev and then the standard merge path.",
      "expected": "Precheck reports stale position without rebasing; normal merge judges rebased commit; stale un-named-test findings are not falsely attributed."
    },
    {
      "id": "LEGACY-REOPEN",
      "source_contracts": [
        "OWNER-REOPEN",
        "POLICY-A18b"
      ],
      "action": "Call the preserved reopen command on a delivered fixture issue with an authorized reason.",
      "expected": "Create and link a new Backlog issue; original delivered issue stays unchanged; no worker is started by status mutation."
    },
    {
      "id": "LEGACY-PART-OF",
      "source_contracts": [
        "PARTIAL-COMMIT",
        "COMMIT-GUARD"
      ],
      "action": "Merge a Part-of commit while other required issue work remains unfinished.",
      "expected": "Link its evidence but do not close or advance the entire issue prematurely."
    },
    {
      "id": "LEGACY-OWN-DB",
      "source_contracts": [
        "WORKTREE-SETUP",
        "WORKTREE-DB",
        "MERGE-DB"
      ],
      "action": "Prepare a fresh worktree; create its owned stack; merge its work.",
      "expected": "No task uses the shared stack. Existing merge stop/remove lifecycle remains sole authority during merge; cleanup warning retains merged outcome."
    },
    {
      "id": "LEGACY-RULES-COPY",
      "source_contracts": [
        "RULE-COPY",
        "SYSTEMD",
        "SCAN-WATCH"
      ],
      "action": "Attempt mutation through stale worktree, materialized Git rules, old hook, drain and timer after authority cutover.",
      "expected": "Every old writer is stopped or rejected by fencing; no old Git-object handoff can restore legacy policy."
    },
    {
      "id": "LEGACY-TEST-CLEANUP",
      "source_contracts": [
        "TEST-CLEANUP",
        "POLICY-A14c"
      ],
      "action": "Close one fixture run while another run and unfinished development tracking have open issues.",
      "expected": "Only proven owned fixture records change after verdict capture; other run/user/development records stay unchanged."
    },
    {
      "id": "LEGACY-PROFILE",
      "source_contracts": [
        "HOST-HOME",
        "PROCESS-IDENTITY"
      ],
      "action": "Run sessions under different config roots on macOS and Linux, including inaccessible process metadata.",
      "expected": "Explicit profile/principal/session capability remains authoritative; missing observation is unknown, never no active work."
    },
    {
      "id": "LEGACY-FIX-FORWARD",
      "source_contracts": [
        "AFTER-MERGE",
        "POSTMERGE"
      ],
      "action": "Report green after-merge results with selected-but-not-run files, omitted files and actually executed carried proof.",
      "expected": "Only actual matching execution at the verified artifact can close fix-forward work; omission or selection alone is not proof."
    },
    {
      "id": "LEGACY-CUTOVER-DELTA",
      "source_contracts": [
        "STATE-REPO",
        "JOURNAL",
        "OUTBOX",
        "SYSTEMD"
      ],
      "action": "Import state, fence writers, activate new authority and inject failure after new writes.",
      "expected": "Preserve post-cutover facts; never restore an old snapshot blindly or enable two writers."
    },
    {
      "id": "LEGACY-LEAD-ACK",
      "source_contracts": [
        "LEAD-DELIVERY",
        "JOURNAL",
        "SCAN-WATCH"
      ],
      "action": "Queue an agent outcome while two lead sessions share a checkout; restart after delivery but before AI acknowledgement; later produce a public user report.",
      "expected": "Only the bound authorized lead receives its outcome; durable per-session cursor and distinct acknowledgement/report receipts prevent loss, cross-session consumption and false completion."
    }
  ],
